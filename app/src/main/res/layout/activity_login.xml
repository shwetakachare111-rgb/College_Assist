<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <!-- Logo / Illustration -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="🏫"
            android:textSize="55sp"
            android:gravity="center"
            android:background="#DCEBFF"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="25dp" />

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WELCOME BACK"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#163A6B"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in to your CampusAssist account"
            android:textSize="14sp"
            android:textColor="#607080"
            android:gravity="center"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="35dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#163A6B"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:backgroundTint="#2878D4"
            android:layout_marginBottom="18dp" />

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#163A6B"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:padding="15dp"
            android:backgroundTint="#2878D4"
            android:layout_marginBottom="28dp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="LOGIN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2878D4"
            android:elevation="5dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CampusAssist • College Help System"
            android:textSize="12sp"
            android:textColor="#8A98A8"
            android:gravity="center"
            android:layout_marginTop="35dp" />

    </LinearLayout>

</ScrollView>