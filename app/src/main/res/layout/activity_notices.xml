<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F8FF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COLLEGE NOTICES"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#163A6B"
        android:gravity="center"
        android:layout_marginTop="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stay updated with the latest college information"
        android:textSize="15sp"
        android:textColor="#526579"
        android:gravity="center"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="22dp" />

    <!-- INFORMATION BOX -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#DCEBFF"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="📢"
            android:textSize="27sp"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap any notice to hear it read aloud."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#163A6B"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- NOTICE LIST -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Latest College Notices"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#163A6B"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/noticesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#B8CBE3"
        android:dividerHeight="3dp"
        android:padding="4dp"
        android:clipToPadding="false"
        android:background="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CampusAssist • College Announcements"
        android:textSize="12sp"
        android:textColor="#718096"
        android:gravity="center"
        android:padding="12dp" />

</LinearLayout>